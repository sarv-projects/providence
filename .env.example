# =============================================================================
# Providence — environment template
# Copy to .env and fill what you need.
#
# Workhorse = OpenCode Zen free (no key). Thinker = Gemini (GEMINI_API_KEY).
# Search = Exa when EXA_API_KEY is set.
# See docs/PROVIDERS.md · docs/INSTALL.md
# =============================================================================

# ── LLM (optional — Zen free works without these) ─────────────────────────────

# Groq — https://console.groq.com/docs/openai
# Base URL: https://api.groq.com/openai/v1  (OpenAI-compatible chat/completions)
# Models: llama-3.1-8b-instant, openai/gpt-oss-20b, llama-3.3-70b-versatile,
#         openai/gpt-oss-120b, qwen/qwen3.6-27b, …
# List: GET https://api.groq.com/openai/v1/models
GROQ_API_KEY=
# GROQ_API_KEY_2=

# OpenAI — only if you have a real OpenAI key (sk-...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com

# OpenRouter — https://openrouter.ai  free models use :free suffix
# List: GET https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini (free tier works with API key from AI Studio)
GEMINI_API_KEY=

# NVIDIA NIM
NVIDIA_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Cohere Platform
CO_API_KEY=

# ── Web search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
# Firecrawl — https://firecrawl.dev (cloud) or self-hosted; needs FIRECRAWL_API_KEY
FIRECRAWL_API_KEY=

# ── Gateway (resilience / cost control) ────────────────────────────────────────
# GATEWAY_MASTER_KEY=
# GATEWAY_MAX_ATTEMPTS=3
# GATEWAY_RETRY_BASE_S=0.5
# GATEWAY_RETRY_CAP_S=8
# GATEWAY_DEFAULT_RPM=60
# GATEWAY_DEFAULT_TPM=120000
# GATEWAY_MAX_PARALLEL=20
# GATEWAY_CIRCUIT_THRESHOLD=5
# GATEWAY_CIRCUIT_COOLDOWN_S=30

# ── Vector store ──────────────────────────────────────────────────────────────
# VECTOR_BACKEND=lancedb
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# EMBEDDING_API_KEY=                    # dedicated embeddings key
# OPENAI_EMBEDDING_KEY=
# USE_CHAT_KEY_FOR_EMBEDDINGS=0         # set 1 to reuse OPENAI_API_KEY for embeddings
# EMBEDDING_LOCAL=bow                   # bow | dummy — local fallback without API
# EMBEDDING_DIM=1536                    # must match the existing store; changing it needs a fresh data/ dir
# RERANK_ENABLED=1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# PROVIDENCE_DISABLE_MODEL_DISCOVERY=1  # skip live GET /models discovery
# PROVIDENCE_DISCOVERY_TTL_S=120       # live catalog freshness (0 = fetch on every load)
# PROVIDENCE_OFFLINE=1                  # offline test mode (live-network tests exit 0)

# ── Temporal (optional ultra-long) ────────────────────────────────────────────
# TEMPORAL_SERVER_ADDRESS=localhost:7233
# TEMPORAL_TASK_QUEUE=research-agent

# ── Factoid extraction (ultra-long dial only) ──────────────────────────────────
# Code reads OLLAMA_HOST (or LOCAL_LLM_URL); LOCAL_LLM_MODEL selects the model.
# OLLAMA_HOST=http://localhost:11434
# LOCAL_LLM_MODEL=llama3:8b
# FACTOID_MODEL=llama3:8b
# NOUGAT_API_URL=                       # Nougat neural-OCR REST endpoint (optional)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins ("*" for open). The Next.js UI proxies
# /api/* same-origin, so the localhost default is sufficient for local dev.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── App Paths ──────────────────────────────────────────────────────────────────
# DATA_DIR=./data
# REPORTS_DIR=./reports

# Exa neural search — https://docs.exa.ai
EXA_API_KEY=

# ── Newswire (tier-1 press coverage) ────────────────────────────────────
# GDELT needs NO key — always available, real-time global newswire, but
# throttled under concurrency. Add NewsData.io for reliable daily wire:
# https://newsdata.io  (free tier ~200 credits/day, commercial-OK)
# NEWSDATA_API_KEY=
